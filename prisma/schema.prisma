// Prisma schema for Rameez Jewellerz - MongoDB
// Only necessary collections are kept: User, Product, Review, Order, OrderItem, Coupon, Offer, ContactMessage, CustomQuote, GalleryImage

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid()) @map("_id")
  name       String
  email      String   @unique
  phone      String   @unique
  password   String
  isVerified Boolean  @default(false)
  address    String?  @default("")
  city       String?  @default("")
  pincode    String?  @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reviews    Review[]
  orders     Order[]
}

model Product {
  id          String   @id @default(cuid()) @map("_id")
  name        String
  nameTa      String?
  slug        String   @unique
  description String
  descriptionTa String?
  category    String
  material    String
  purity      String?
  weight      Float
  makingCharge Float   @default(0)
  price       Float
  oldPrice    Float?
  image       String
  images      String   @default("[]")
  stock       Int      @default(10)
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  isFeatured  Boolean  @default(false)
  isNew       Boolean  @default(false)
  isBestSeller Boolean @default(false)
  isOffer     Boolean  @default(false)
  tags        String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews     Review[]
}

model Review {
  id         String   @id @default(cuid()) @map("_id")
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  author     String
  rating     Int
  title      String   @default("")
  comment    String
  reviewType String   @default("product") // "product" or "customer"
  approved   Boolean  @default(true)      // admin approves/edits
  visible    Boolean  @default(true)      // admin decides which show on customer review page
  source     String   @default("admin")   // "admin" or "user"
  createdAt  DateTime @default(now())
}

model Order {
  id           String   @id @default(cuid()) @map("_id")
  sessionId    String
  userId       String?
  customerName String
  phone        String
  email        String?
  address      String
  city         String
  pincode      String
  paymentMethod String  @default("Book Order")
  status       String   @default("Pending")
  subtotal     Float
  makingCharge Float    @default(0)
  discount     Float    @default(0)
  total        Float
  couponCode   String?
  items        String   @default("[]")
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id])
}

model Coupon {
  id        String   @id @default(cuid()) @map("_id")
  code      String   @unique
  type      String   @default("percent")
  value     Float
  minOrder  Float    @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Offer {
  id            String   @id @default(cuid()) @map("_id")
  title         String
  titleTa       String?
  description   String
  descriptionTa String?
  discountLabel String   @default("")
  offerType     String   @default("percent")
  discountValue Float    @default(0)
  icon          String   @default("Crown")
  active        Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  phone     String
  email     String?
  message   String
  createdAt DateTime @default(now())
}

model CustomQuote {
  id          String   @id @default(cuid()) @map("_id")
  name        String
  phone       String
  email       String?
  material    String
  budget      Float
  description String
  image       String?
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
}

model GalleryImage {
  id        String   @id @default(cuid()) @map("_id")
  label     String
  labelTa   String?
  category  String   @default("Gold")
  image     String
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}
